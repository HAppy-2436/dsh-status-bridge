{
  "name": "dsh-status-bridge",
  "version": "0.1.1",
  "description": "DSH plugin that bridges DeepSeek Harness session status to the macOS menu bar app DSH Status and forwards jump-to-session commands.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HAppy-2436/dsh-status-bridge.git"
  },
  "homepage": "https://github.com/HAppy-2436/dsh-status-bridge#readme",
  "bugs": {
    "url": "https://github.com/HAppy-2436/dsh-status-bridge/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "macos",
    "menu-bar",
    "status",
    "session",
    "bridge"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/aggregate.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/protocol.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check lib/aggregate.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  }
}
